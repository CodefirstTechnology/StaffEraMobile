# syntax=docker/dockerfile:1

FROM node:20-alpine AS build
WORKDIR /app

ARG VITE_HOUSE_OWNER_APP_URL
ARG VITE_SERVANT_APP_URL
ARG VITE_AGENT_PORTAL_URL
ARG VITE_PLAY_STORE_HOUSE_OWNER
ARG VITE_PLAY_STORE_SERVANT
ARG VITE_APP_STORE_HOUSE_OWNER
ARG VITE_APP_STORE_SERVANT

ENV VITE_HOUSE_OWNER_APP_URL=$VITE_HOUSE_OWNER_APP_URL
ENV VITE_SERVANT_APP_URL=$VITE_SERVANT_APP_URL
ENV VITE_AGENT_PORTAL_URL=$VITE_AGENT_PORTAL_URL
ENV VITE_PLAY_STORE_HOUSE_OWNER=$VITE_PLAY_STORE_HOUSE_OWNER
ENV VITE_PLAY_STORE_SERVANT=$VITE_PLAY_STORE_SERVANT
ENV VITE_APP_STORE_HOUSE_OWNER=$VITE_APP_STORE_HOUSE_OWNER
ENV VITE_APP_STORE_SERVANT=$VITE_APP_STORE_SERVANT

COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:1.27-alpine AS runtime
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ || exit 1
