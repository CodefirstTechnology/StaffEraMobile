{
  "expo": {
    "name": "servant-app",
    "slug": "servant-app",
    "owner": "pravinbehere45",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "servantapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.justdailai.servant",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.justdailai.servant",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "INTERNET"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow StaffEra to access your photos so you can choose a profile picture.",
          "cameraPermission": "Allow StaffEra to use your camera so you can take a profile picture."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "0c4864b0-0f26-4ec6-aabe-64255b2a3032"
      }
    }
  }
}
